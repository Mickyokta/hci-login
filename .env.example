# Connection string Neon (Dashboard Neon -> Connect).
# Pooled (host mengandung "-pooler"), dipakai aplikasi saat runtime:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (tanpa "-pooler"), dipakai Prisma CLI untuk migrasi:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Rahasia untuk menandatangani cookie sesi (minimal 32 karakter acak).
# Buat dengan: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
